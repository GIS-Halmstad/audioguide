{
  "name": "audioguide",
  "private": true,
  "version": "1.4.0",
  "description": "Audioguide",
  "license": "MIT",
  "author": "Jacob Wodzyński",
  "homepage": "https://github.com/GIS-Halmstad/audioguide#readme",
  "repository": "https://github.com/GIS-Halmstad/audioguide.git",
  "bugs": {
    "url": "https://github.com/GIS-Halmstad/audioguide/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "cross-env NODE_ENV=production vite build",
    "build-capacitor-ios": "cross-env NODE_ENV=production vite build && npx cap copy ios",
    "build-capacitor-android": "cross-env NODE_ENV=production vite build && npx cap copy android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "flag-icons": "^7.5.0",
    "framework7": "^9.0.5",
    "framework7-icons": "^5.0.5",
    "framework7-react": "^9.0.5",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "material-icons": "^1.13.14",
    "ol": "^10.9.0",
    "plausible-tracker": "^0.3.9",
    "proj4": "^2.20.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@eslint/js": "^9.39.3",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss-preset-env": "^11.3.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.1"
  }
}